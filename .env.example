# ==============================================================================
# Website RAG Chatbot - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and provide your actual credentials:
#   cp .env.example .env
#
# IMPORTANT: The target site URL is strictly confidential. Never commit your .env file!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Target Website Configuration (STRICTLY CONFIDENTIAL)
# ------------------------------------------------------------------------------
# The root URL of the single company website to crawl and index.
SITE_URL="https://example-confidential-site.com"

# Crawl rate limit (requests per second) for robots.txt politeness
CRAWL_RATE_LIMIT=1.0

# ------------------------------------------------------------------------------
# 2. LLM & Embeddings (Google Gemini API)
# ------------------------------------------------------------------------------
# Free / Pay-as-you-go Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="AIzaSy..."

# Generation and embedding models
GEMINI_MODEL="gemini-2.0-flash"
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIM=768

# ------------------------------------------------------------------------------
# 3. Web Crawling & Scraping Ingestion
# ------------------------------------------------------------------------------
# Primary Scraper: Firecrawl API Key (https://www.firecrawl.dev/)
FIRECRAWL_API_KEY="fc-..."

# Fallback Scraper: TinyFish AI (TinyFetch) API Key (https://www.tinyfish.ai/)
# Automatically called if Firecrawl fails or hits rate limits.
TINYFISH_API_KEY="tf_..."

# ------------------------------------------------------------------------------
# 4. Vector Database (Qdrant Dual Parity)
# ------------------------------------------------------------------------------
# LOCAL LAPTOP DEV: Leave QDRANT_URL blank to automatically use local embedded storage
# VERCEL / CLOUD PROD: Supply Qdrant Cloud cluster endpoint & API key
QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION="site_kb"
QDRANT_LOCAL_PATH="./data/qdrant_data"

# ------------------------------------------------------------------------------
# 5. Guardrails & Thresholds
# ------------------------------------------------------------------------------
# Minimum Reciprocal Rank Fusion (RRF) score to pass relevance gate (0.0 to 1.0)
MIN_RELEVANCE_SCORE=0.35

# Minimum semantic similarity score for standalone dense vectors
SEMANTIC_SIMILARITY_MIN=0.65

# Top-K chunks retrieved per query (or 3+3 balanced chunks in comparison mode)
TOP_K=6

# Enforce strict number & fee consistency verification against context chunks
STRICT_NUMBER_CHECK=true

# ------------------------------------------------------------------------------
# 6. Observability & Tracing (Optional)
# ------------------------------------------------------------------------------
# LangSmith Tracing
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="web-assist-rag"

# Langfuse Tracing
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"
